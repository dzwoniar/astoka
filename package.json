{
  "name": "astoka",
  "version": "0.1.0",
  "private": true,
  "description": "Astoka — wewnętrzne narzędzie Akademii 100k do automatycznej produkcji shortów",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @astoka/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "codegen": "bash scripts/codegen.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
