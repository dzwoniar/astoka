# Astoka — environment template. Copy to .env and customize.

# === Postgres ===
POSTGRES_USER=astoka
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=astoka
POSTGRES_PORT=5432

# === Redis ===
REDIS_PORT=6379

# === MinIO ===
MINIO_ROOT_USER=astoka
# Default password matches docker-compose.dev.yml. Change for production.
MINIO_ROOT_PASSWORD=astoka_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=astoka
# Browser-facing endpoint for presigned PUT/GET URLs.
# Change to public hostname (e.g. minio.example.com) when deploying behind Traefik.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# === ASR (faster-whisper) ===
# Defaults to medium (~1.5GB, good PL accuracy).
# Other options:
#   Systran/faster-whisper-large-v3        — best quality, ~3GB, slower
#   Systran/faster-distil-whisper-large-v3 — distilled, ~1.5GB, fastest
#   Systran/faster-whisper-small           — ~500MB, lower quality
WHISPER_MODEL=Systran/faster-whisper-medium

# === Ollama ===
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.3:8b-instruct-q4_K_M

# === API ===
API_PORT=8000
API_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
API_CORS_ORIGINS=http://localhost:3000,https://astoka.local

# === Web ===
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# === Traefik ===
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# === Flower (Celery monitoring) ===
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=changeme_dev_only

# === LLM provider ===
# local | openai_compatible
LLM_PROVIDER=local
# Used only if LLM_PROVIDER=openai_compatible (HIGH-08 fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === GPU (set to "all" or specific device IDs) ===
NVIDIA_VISIBLE_DEVICES=all
